/* ============================================================
   BH — Firebase Realtime Database Rules
   ============================================================
   📋 انسخ كل المحتوى اللي تحت ده → Firebase Console →
      Realtime Database → Rules → استبدل كل اللي موجود → Publish

   أو (الطريقة السهلة): افتح الرابط ده وهيفتحلك الصفحة جاهزة:
   https://console.firebase.google.com/project/bhxx-2a3be/database/bhxx-2a3be-default-rtdb/rules

   ------------------------------------------------------------
   القواعد:
   • كل مستخدم عنده مساحة خاصة: users/{uid}
   • يقدر يقرا ويكتب بس في مساحته هو
   • محدش يقدر يقرا أو يعدّل بيانات حد تاني
   • مفيش قراءة عامة للـ root
   ============================================================ */

{
  "rules": {
    "users": {
      "$uid": {
        ".read":  "$uid === auth.uid",
        ".write": "$uid === auth.uid",

        "app": {
          ".validate": "newData.hasChildren(['balances', 'incomes'])"
        },

        "meta": {
          ".validate": "newData.hasChildren(['lastSync'])"
        }
      }
    }
  }
}

<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme (dark, matching the app) -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/bh_accent</item>
        <item name="colorPrimaryDark">@color/bh_background</item>
        <item name="colorAccent">@color/bh_accent</item>
        <item name="android:windowBackground">@color/bh_background</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Dark background: prevents the white flash before the web app paints -->
        <item name="android:background">@color/bh_background</item>
        <item name="android:windowBackground">@color/bh_background</item>
        <item name="android:colorBackground">@color/bh_background</item>
        <item name="android:statusBarColor">@color/bh_background</item>
        <item name="android:navigationBarColor">@color/bh_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- Launch theme: the native splash with the BH logo -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/bh_splash_background</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/bh_background</item>
        <item name="android:navigationBarColor">@color/bh_background</item>
    </style>
</resources>
